{
  "name": "RED-COVERAGE",
  "stage": "standing",
  "structural_checks": [
    {
      "check": "red_coverage_scan",
      "command": "python3 scripts/_red_attacks.py coverage 2>/dev/null | grep -q '\"phase\": \"coverage\"'",
      "fail_if": "exit_code != 0"
    },
    {
      "check": "audit_outcome_present",
      "command": "test -f scripts/gk_audit_outcome.py",
      "fail_if": "exit_code != 0"
    },
    {
      "check": "red_coverage_findings_json",
      "command": "python3 scripts/_red_attacks.py coverage 2>/dev/null | grep -q '\"findings\"'",
      "fail_if": "exit_code != 0"
    }
  ]
}
