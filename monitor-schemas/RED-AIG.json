    },
    {
      "check": "red_aig_engine_present",
      "command": "test -f scripts/_red_attacks.py",
      "fail_if": "exit_code != 0"
    },
    {
      "check": "red_aig_findings_json",
      "command": "python3 scripts/_red_attacks.py aig 2>/dev/null | grep -q '\"findings\"'",
      "fail_if": "exit_code != 0"
    }
  ]
}
