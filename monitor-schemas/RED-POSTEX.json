{
  "name": "RED-POSTEX",
  "stage": "standing",
  "structural_checks": [
    {
      "check": "reflect_available",
      "command": "bash gatekeeper-cli.sh reflect 2>/dev/null | grep -q '\"ok\"'",
      "fail_if": "exit_code != 0"
    },
    {
      "check": "self_check_ok",
      "command": "bash gatekeeper-cli.sh self-check 2>/dev/null | grep -q '\"issues\":0'",
      "fail_if": "exit_code != 0"
    },
    {
      "check": "audit_memory_available",
      "command": "bash gatekeeper-cli.sh audit --memory 2>/dev/null | grep -q '\"history_count\"'",
      "fail_if": "exit_code != 0"
    },
    {
      "check": "gitnexus_query_available",
      "command": "bash gatekeeper-cli.sh monitor --gitnexus RED-POSTEX 2>/dev/null | grep -q '\"query\"'",
      "fail_if": "exit_code != 0"
    }
  ]
}
