{
  "_comment": "MCP 声明面模板。按宿主描述符实测填写；integrity 必须为 sha512-<hex>。未填 ⟹ gk_mcp_loader verify 非零退出（fail-closed）。真实清单请另存为 mcp_manifest.json，不要提交本机 venv/路径。",
  "servers": [
    {
      "server": "filesystem",
      "version": "REPLACE_PINNED_VERSION",
      "integrity": "REPLACE_ME",
      "scope": "official",
      "cap": ["read", "write"],
      "tools": ["read_text_file", "write_file", "edit_file", "list_directory"]
    },
    {
      "server": "windows-cli",
      "version": "REPLACE_PINNED_VERSION",
      "integrity": "REPLACE_ME",
      "scope": "local",
      "cap": ["exec"],
      "tools": ["execute_command", "ssh_execute"]
    }
  ]
}
